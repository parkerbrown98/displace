{
  "name": "server",
  "version": "0.0.1",
  "description": "The Displace Web API.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "db:bootstrap": "tsx src/database/cli/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:initial-admin": "tsx src/database/cli/initial-admin.ts",
    "db:migrate": "tsx src/database/cli/migrate.ts",
    "db:reset": "tsx src/database/cli/reset.ts",
    "db:seed": "tsx src/database/cli/seed.ts",
    "db:setup": "pnpm db:bootstrap && pnpm db:migrate",
    "search:reindex": "tsx src/search/cli/reindex.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "worker:dev": "nest start --watch --entryFile worker",
    "worker:start": "nest start --entryFile worker",
    "worker:prod": "node dist/worker"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/websockets": "^12.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "file-type": "^22.1.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.0",
    "meilisearch": "^0.62.0",
    "nestjs-pino": "^5.2.0",
    "nodemailer": "^10.0.10",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}

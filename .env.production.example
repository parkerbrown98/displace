# Copy to .env.production, replace every change-me value, and keep the result out of version control.
DISPLACE_API_IMAGE=displace-api:local
DISPLACE_WEB_IMAGE=displace-web:local

# Bind HTTP services to loopback when TLS terminates on this host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=3001
S3_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LIVEKIT_BIND_ADDRESS=127.0.0.1
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881

PUBLIC_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
CORS_ORIGINS=https://example.com
S3_PUBLIC_ENDPOINT=https://assets.example.com
LIVEKIT_PUBLIC_URL=wss://voice.example.com
# The API must trust only the address range from which its reverse proxy connects.
# For a proxy on this Docker host using the default loopback API binding, use the
# `displace_edge` network subnet (see repos/server/README.md). Do not use `true`.
TRUST_PROXY=172.16.0.0/12
LOG_LEVEL=info

# Keep generated values URL-safe because Compose inserts them into connection URLs.
POSTGRES_DB=displace
POSTGRES_USER=displace
POSTGRES_PASSWORD=change-me-migration-database-password
POSTGRES_RUNTIME_USER=displace_app
POSTGRES_RUNTIME_PASSWORD=change-me-runtime-database-password
REDIS_PASSWORD=change-me-redis-password

MINIO_ROOT_USER=displace
MINIO_ROOT_PASSWORD=change-me-object-storage-password
MINIO_BUCKET=displace
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MEILISEARCH_MASTER_KEY=change-me-search-master-key

LIVEKIT_API_KEY=change-me-livekit-api-key
LIVEKIT_API_SECRET=change-me-livekit-api-secret
ACCESS_TOKEN_SECRET=change-me-at-least-32-characters-access-token
REFRESH_TOKEN_PEPPER=change-me-at-least-32-characters-refresh-token
COOKIE_SECRET=change-me-at-least-32-characters-cookie-signing
CURSOR_SECRET=change-me-at-least-32-characters-cursor-signing

# Create a sending-only key restricted to the verified EMAIL_FROM domain.
RESEND_API_KEY=change-me-resend-api-key
EMAIL_FROM=no-reply@example.com

MALWARE_SCANNER_URL=
MALWARE_SCANNER_REQUIRED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
SINGLE_PLACE_MODE=false
SINGLE_PLACE_SLUG=